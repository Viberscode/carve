# Set these as Vercel environment variables. Never commit real values.

# Required on Vercel. Signs session cookies. Minimum 32 characters.
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
# Without it, sign-in returns HTTP 503. Changing it signs every user out.
# Local `python serve.py` generates its own key in server-data/ if this is unset.
CARVE_SESSION_SECRET=

# Optional. Public Google OAuth client ID. Defaults to the value in auth-config.js.
CARVE_GOOGLE_CLIENT_ID=

# Dodo Payments (or use dodo-secrets.json locally).
DODO_PAYMENTS_API_KEY=
DODO_PAYMENTS_WEBHOOK_KEY=
DODO_PAYMENTS_PRODUCT_ID=
DODO_PAYMENTS_ENVIRONMENT=test
